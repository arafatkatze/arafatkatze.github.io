<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <!-- Navbar Toggle (mobile) -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <div class="pill-nav-row">
          <div class="pill-nav-wrapper">
            {% for page_item in site.pages %}
              {% if page_item.permalink == '/' %}
                {% assign about_title = page_item.title %}
              {% endif %}
            {% endfor %}

            <!-- About / Home -->
            <a class="pill-nav-link {% if page.permalink == '/' %}active{% endif %}" href="{{ '/' | relative_url }}">
              {{- about_title -}}
            </a>

            <!-- Other pages -->
            {% assign sorted_pages = site.pages | sort: 'nav_order' %}
            {% for p in sorted_pages %}
              {% if p.nav and p.autogen == null %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- elsif p.permalink contains '/blog/' -%}
                  {%- assign url = '/blog/' -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a class="pill-nav-link {% if page.url contains parent_link %}active{% endif %}" href="{{ url | relative_url }}">
                  {{- p.title -}}
                </a>
              {% endif %}
            {% endfor %}
          </div>

          <div class="pill-nav-actions">
            {% if site.search_enabled %}
              <button id="search-toggle" class="pill-nav-icon" title="Search" aria-label="Search" onclick="openSearchModal()">
                <svg class="pill-nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="10.5" cy="10.5" r="6.5" /><path d="M20 20l-4.8 -4.8" />
                </svg>
              </button>
            {% endif %}
            {% if site.enable_darkmode %}
              <button id="light-toggle" class="pill-nav-icon" title="Change theme" aria-label="Change theme">
                {% comment %} system: half-filled disc, dark: moon, light: sun {% endcomment %}
                <svg class="pill-nav-svg" id="light-toggle-system" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="8" /><path class="pill-nav-svg-fill" d="M12 4a8 8 0 0 1 0 16z" />
                </svg>
                <svg class="pill-nav-svg" id="light-toggle-dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path class="pill-nav-svg-fill" d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
                </svg>
                <svg class="pill-nav-svg" id="light-toggle-light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle class="pill-nav-svg-fill" cx="12" cy="12" r="4" />
                  <path d="M12 2.5v2.5M12 19v2.5M2.5 12h2.5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8 -1.8M16.9 7.1l1.8 -1.8" />
                </svg>
              </button>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
